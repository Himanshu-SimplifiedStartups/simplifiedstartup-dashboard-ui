# Base URL of simplifiedstartup-server (no trailing slash).
# This is the LIVE server — what the dashboard uses by default.
VITE_API_URL=http://localhost:4000

# Optional: a second server for TEST mode. When set, a Live/Test toggle appears
# in the dashboard (sidebar + login card) and Test mode talks to this URL
# instead. Leave unset for local development against a single server.
# VITE_API_URL_TEST=https://simplifiedstartup-server.vercel.app
